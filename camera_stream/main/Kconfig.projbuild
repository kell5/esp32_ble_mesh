menu "Camera Stream Configuration"

    choice EXAMPLE_PROV_TRANSPORT
        prompt "WiFi provisioning transport"
        default EXAMPLE_PROV_TRANSPORT_BLE

        config EXAMPLE_PROV_TRANSPORT_BLE
            bool "BLE (recommended)"

        config EXAMPLE_PROV_TRANSPORT_SOFTAP
            bool "SoftAP compatibility mode"
    endchoice

    config EXAMPLE_PROV_SOFTAP_PREFIX
        string "Provisioning device name prefix"
        default "Doorbell-"
        help
            The BLE advertisement or SoftAP name is built as
            "<prefix><last 3 MAC bytes>", e.g. Doorbell-4C3408.

    config EXAMPLE_PROV_POP
        string "Provisioning proof-of-possession"
        default "doorbell1234"
        help
            Proof-of-possession string for Security1 provisioning. The App must use
            the same value when sending WiFi credentials over BLE or SoftAP.

    config EXAMPLE_MQTT_BROKER_URI
        string "MQTT broker URI"
        default "mqtt://121.40.131.194:1883"
        help
            URI of the MQTT broker used for doorbell signalling.

    config EXAMPLE_MQTT_USERNAME
        string "MQTT username"
        default "yskj"

    config EXAMPLE_MQTT_PASSWORD
        string "MQTT password"
        default "yskj@123"

    config EXAMPLE_MQTT_CLIENT_ID
        string "MQTT client id"
        default "esp32s3_doorbell"

    config EXAMPLE_DOORBELL_ID
        string "Doorbell device id"
        default "door-001"
        help
            Used to build the MQTT event, command, and retained status topics.

    config EXAMPLE_RELAY_HOST
        string "MJPEG relay host"
        default "114.55.208.72"
        help
            Host/IP of the MJPEG relay (server_relay/mjpeg_relay.py). The board
            pushes JPEG frames to http://<host>:<port>/pub/<doorbell_id>; the App
            views them at http://<host>:<port>/stream/<doorbell_id>.

    config EXAMPLE_RELAY_PORT
        int "MJPEG relay port"
        default 8090
        range 1 65535

    config EXAMPLE_STREAM_TIMEOUT_SEC
        int "Stream inactivity timeout (seconds)"
        default 60
        range 5 600
        help
            The relay push auto-stops this many seconds after the doorbell rings
            unless a hangup command is received first.

    config EXAMPLE_DOORBELL_GPIO
        int "Doorbell button GPIO"
        default 0
        range 0 48
        help
            GPIO connected to the doorbell push button (active low).

endmenu
