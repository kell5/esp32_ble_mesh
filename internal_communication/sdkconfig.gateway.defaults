# Dedicated ESP32-S3 gateway profile: BLE provisioning + stored router credentials.
CONFIG_MESH_GATEWAY_PROVISIONING=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
CONFIG_MESH_PRODUCT_ID="mesh_gateway"
CONFIG_MESH_HW_VERSION="rev-a"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
